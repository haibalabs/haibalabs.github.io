rules_version = '2';

// Access is invite-only. Each invited account has users/{uid} with a role; a signed-in account
// without that document can read and write nothing. Collections not matched below are denied.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasRole(roles) {
      return signedIn() && exists(userPath()) && get(userPath()).data.role in roles;
    }

    function isMember() {
      return hasRole(['viewer', 'editor', 'reviewer', 'admin']);
    }

    function isEditor() {
      return hasRole(['editor', 'reviewer', 'admin']);
    }

    function isAdmin() {
      return hasRole(['admin']);
    }

    // Roles. Admins manage other accounts' roles; nobody changes their own.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update: if isAdmin()
        && uid != request.auth.uid
        && request.resource.data.keys().hasOnly(['role'])
        && request.resource.data.role in ['viewer', 'editor', 'reviewer', 'admin'];
      allow delete: if isAdmin() && uid != request.auth.uid;
    }

    // Shared event datasets (events_main for the world dataset). Documents are keyed by the
    // event's own event_id; every write is attributed to its author and stamped with the server time.
    match /{collection}/{eventId} {
      allow read: if collection.matches('events_.+') && isMember();
      allow create, update: if collection.matches('events_.+')
        && isEditor()
        && request.resource.data.event_id == eventId
        && request.resource.data.name is string
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.lastModified == request.time;
      allow delete: if collection.matches('events_.+') && isAdmin();
    }

    // Proposed edits to world events (../WORLD-EDITS.md). Editors, reviewers and admins write
    // their own; only the author and admins read them. Authors never write review results:
    // checks.automatic comes from the agents' checker (Admin SDK, outside these rules), and review
    // fields, field dispositions and publication come from admins. Nothing is deleted.
    // Locations are edited per position, location[0] to location[4] (LOCATION_SLOTS in world-edits.js).
    function editFieldNames() {
      return ['name', 'enhanced_time', 'enhanced_description', 'figures', 'categories', 'wikipedia_url', 'image',
          'location[0]', 'location[1]', 'location[2]', 'location[3]', 'location[4]'];
    }

    function addsOnly(changes, field) {
      return !(field in changes) || changes[field].before == null;
    }

    // A new event: the required fields filled in, and nothing it replaces.
    function validNewEvent(changes) {
      return changes.keys().hasAll(['name', 'enhanced_time', 'enhanced_description'])
        && changes.name.before == null && changes.name.after is string && changes.name.after.size() > 0
        && changes.enhanced_time.before == null && changes.enhanced_time.after is string
        && changes.enhanced_time.after.size() > 0
        && changes.enhanced_description.before == null && changes.enhanced_description.after is string
        && changes.enhanced_description.after.size() > 0
        && addsOnly(changes, 'figures') && addsOnly(changes, 'categories') && addsOnly(changes, 'wikipedia_url')
        && addsOnly(changes, 'image') && addsOnly(changes, 'location[0]') && addsOnly(changes, 'location[1]')
        && addsOnly(changes, 'location[2]') && addsOnly(changes, 'location[3]') && addsOnly(changes, 'location[4]');
    }

    // A proposed upload points at the author's own file for this edit (storage.rules, edit_uploads).
    function validImageChange(data) {
      let image = data.changes.get('image', {'after': null}).after;
      return image == null || image.get('asset', null) == null
        || image.asset.path.matches('edit_uploads/' + data.author.uid + '/' + data.edit_id
            + '/r[0-9]+-[0-9a-f]{64}[.](webp|jpg)');
    }

    function validEditContent(data) {
      return data.keys().hasOnly(['edit_id', 'kind', 'event_id', 'event_name', 'dataset', 'changes',
          'reason', 'sources', 'source_conflict', 'author', 'created_at', 'revised_at', 'revision',
          'content_sha256', 'status', 'checks', 'review', 'reviews', 'fields'])
        && (data.kind == 'update' || (data.kind == 'create' && validNewEvent(data.changes)))
        && data.event_id is string
        && data.event_id.matches('evt_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}')
        && data.event_name is string && data.event_name.size() <= 300
        && data.dataset is map
        && data.changes is map && data.changes.size() > 0
        && data.changes.keys().hasOnly(editFieldNames())
        && validImageChange(data)
        && data.reason is string && data.reason.size() <= 1000
        && data.sources is list && data.sources.size() <= 5
        && data.source_conflict is bool
        && data.content_sha256 is string && data.content_sha256.size() == 64
        && data.revision is int
        && data.checks is map && data.checks.keys().hasOnly(['browser']);
    }

    // A quick flag (../WORLD-EDITS.md, Quick flags): an edit of kind "flag" naming the parts of an event
    // its author found wrong, what they saw of each, and an optional note. It changes no field.
    function flagPartNames() {
      return ['image', 'location', 'entities', 'article', 'date', 'description'];
    }

    function validFlagContent(data) {
      return data.keys().hasOnly(['edit_id', 'kind', 'event_id', 'event_name', 'dataset', 'flag', 'author',
          'created_at', 'revised_at', 'revision', 'status', 'review'])
        && data.kind == 'flag'
        && data.event_id is string
        && data.event_id.matches('evt_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}')
        && data.event_name is string && data.event_name.size() <= 300
        && data.dataset is map
        && data.flag is map && data.flag.keys().hasOnly(['parts', 'seen', 'note'])
        && data.flag.parts is list && data.flag.parts.size() > 0 && data.flag.parts.size() <= 6
        && data.flag.parts.hasOnly(flagPartNames())
        && data.flag.seen is map && data.flag.seen.keys().hasOnly(flagPartNames())
        && data.flag.note is string && data.flag.note.size() <= 280
        && data.revision == 1;
    }

    match /edits/{editId} {
      allow read: if signedIn() && (resource.data.author.uid == request.auth.uid || isAdmin());
      allow create: if isEditor()
        && editId.matches('edt_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}')
        && request.resource.data.edit_id == editId
        && validEditContent(request.resource.data)
        && !request.resource.data.keys().hasAny(['review', 'reviews', 'fields'])
        && request.resource.data.status == 'submitted'
        && request.resource.data.revision == 1
        && request.resource.data.author.keys().hasOnly(['uid', 'email'])
        && request.resource.data.author.uid == request.auth.uid
        && request.resource.data.author.email == request.auth.token.email
        && request.resource.data.created_at == request.time
        && request.resource.data.revised_at == request.time;
      // A quick flag, sent open, under the same accounts as edits.
      allow create: if isEditor()
        && editId.matches('edt_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}')
        && request.resource.data.edit_id == editId
        && validFlagContent(request.resource.data)
        && !('review' in request.resource.data)
        && request.resource.data.status == 'open'
        && request.resource.data.author.keys().hasOnly(['uid', 'email'])
        && request.resource.data.author.uid == request.auth.uid
        && request.resource.data.author.email == request.auth.token.email
        && request.resource.data.created_at == request.time
        && request.resource.data.revised_at == request.time;
      // The author takes back an open flag (Undo).
      allow update: if isEditor()
        && resource.data.kind == 'flag'
        && resource.data.author.uid == request.auth.uid
        && resource.data.status == 'open'
        && request.resource.data.status == 'withdrawn'
        && request.resource.data.revised_at == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'revised_at']);
      // An admin closes an open flag as fixed or dismissed, signed with their own account and the server time.
      allow update: if isAdmin()
        && resource.data.kind == 'flag'
        && resource.data.status == 'open'
        && request.resource.data.status in ['fixed', 'dismissed']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'review'])
        && request.resource.data.review.keys().hasOnly(['by', 'decision', 'note', 'at'])
        && request.resource.data.review.by.keys().hasOnly(['uid', 'email', 'role'])
        && request.resource.data.review.by.uid == request.auth.uid
        && request.resource.data.review.by.email == request.auth.token.email
        && request.resource.data.review.decision == request.resource.data.status
        && request.resource.data.review.note is string && request.resource.data.review.note.size() <= 1000
        && request.resource.data.review.at == request.time;
      // The author revises (a new revision, back to submitted) or withdraws an edit that is still
      // waiting for review or rejected.
      allow update: if isEditor()
        && resource.data.author.uid == request.auth.uid
        && resource.data.status in ['submitted', 'flagged', 'ready', 'conflict', 'auto_rejected', 'sent_back', 'rejected']
        && request.resource.data.revised_at == request.time
        && (
          (request.resource.data.status == 'withdrawn'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'revised_at']))
          || (request.resource.data.status == 'submitted'
            && request.resource.data.revision == resource.data.revision + 1
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['changes', 'reason',
                'sources', 'source_conflict', 'content_sha256', 'revision', 'revised_at', 'status',
                'checks', 'dataset', 'event_name'])
            && validEditContent(request.resource.data))
        );
      // An admin decides an open edit: its approved fields published with the overlay in the same
      // write, or the whole edit rejected. The decision names the exact revision shown and is signed
      // with the admin's own account and the server time; earlier decisions move to reviews.
      allow update: if isAdmin()
        && resource.data.status in ['submitted', 'flagged', 'ready', 'conflict', 'auto_rejected']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'review', 'reviews', 'fields', 'published'])
        && validReview(request.resource.data.review)
        && request.resource.data.reviews is list
        && request.resource.data.fields is map
        && (
          (request.resource.data.status == 'rejected' && request.resource.data.review.decision == 'rejected')
          || (request.resource.data.status == 'published' && request.resource.data.review.decision == 'approved'
            && request.resource.data.published.at == request.time
            && request.resource.data.published.overlay_version
              == getAfter(/databases/$(database)/documents/world_overlay/current).data.version
            && overlayBumpedInThisWrite())
        );
      allow delete: if false;
    }

    // getAfter returns the overlay unchanged when the write doesn't touch it, so an approval must also
    // raise the overlay's version in the same write: 1 for the first, one higher after that.
    function overlayBumpedInThisWrite() {
      let path = /databases/$(database)/documents/world_overlay/current;
      return getAfter(path).data.version == (exists(path) ? get(path).data.version + 1 : 1);
    }

    function validReview(review) {
      return review.keys().hasOnly(['by', 'revision', 'content_sha256', 'decision', 'fields', 'note', 'self_approved', 'at'])
        && review.by.keys().hasOnly(['uid', 'email', 'role'])
        && review.by.uid == request.auth.uid
        && review.by.email == request.auth.token.email
        && review.by.role == 'admin'
        && review.revision == resource.data.revision
        && review.content_sha256 == resource.data.content_sha256
        && review.note is string && review.note.size() <= 1000
        && review.self_approved == (resource.data.author.uid == request.auth.uid)
        && review.at == request.time;
    }

    // Approved edits every visitor sees (../WORLD-EDITS.md, Publishing to visitors). Anyone reads
    // it; admins write it, each time one version higher. It names edits, never people.
    match /world_overlay/{docId} {
      allow read: if docId == 'current';
      allow create, update: if isAdmin() && docId == 'current'
        && request.resource.data.keys().hasOnly(['version', 'patches', 'created', 'updated_at'])
        && request.resource.data.version == (resource == null ? 0 : resource.data.version) + 1
        && request.resource.data.patches is map
        && request.resource.data.created is map
        && request.resource.data.updated_at == request.time;
      allow delete: if false;
    }

    // The published release every visitor sees (../modules/world-release.js): the hash of its manifest in
    // data/manifests/. Anyone reads it; admins move it from the staging page, each time one version higher
    // and naming the release it replaces. It names releases, never people.
    match /world_release/{docId} {
      allow read: if docId == 'current';
      allow create, update: if isAdmin() && docId == 'current'
        && request.resource.data.keys().hasOnly(['version', 'manifest_sha256', 'release_id', 'previous_manifest_sha256', 'updated_at'])
        && request.resource.data.version == (resource == null ? 0 : resource.data.version) + 1
        && request.resource.data.manifest_sha256 is string
        && request.resource.data.manifest_sha256.matches('^[0-9a-f]{64}$')
        && request.resource.data.release_id is string && request.resource.data.release_id.size() <= 200
        && request.resource.data.previous_manifest_sha256 == (resource == null ? null : resource.data.manifest_sha256)
        && request.resource.data.updated_at == request.time;
      allow delete: if false;
    }

    // Personal timelines: private to their owner and any listed members. Editors, reviewers and
    // admins may create timelines. Only the owner renames, shares or deletes one; members read it
    // and edit its events. Firestore does not cascade deletes, so clients delete a timeline's
    // events first.
    //
    // Each event stores the createdAt of the timeline it was written into (timelineCreatedAt),
    // and every event read or write requires it to match the current timeline document. A
    // timeline recreated under the same ID has a new createdAt, so events left from an earlier
    // timeline (leftovers, or writes racing its deletion) stay unreachable for every account.
    // Because the rules test that field, event list queries must filter on it.
    function timelinePath(timelineId) {
      return /databases/$(database)/documents/timelines/$(timelineId);
    }

    function currentTimeline(timelineId) {
      return get(timelinePath(timelineId)).data;
    }

    function validTimelineEvent(timelineId, eventId) {
      let data = request.resource.data;
      return eventId.matches('evt_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}')
        && data.event_id == eventId
        && data.timelineCreatedAt == currentTimeline(timelineId).createdAt
        && data.name is string && data.name.size() > 0 && data.name.size() <= 300
        && data.enhanced_time is string
        && data.userId == request.auth.uid
        && data.lastModified == request.time
        && validImage(timelineId);
    }

    // An event's optional photo (see ../PERSONAL-IMAGES.md): both Storage paths must sit under
    // this event and the timeline's current generation, as storage.rules requires for the files.
    function validImage(timelineId) {
      let data = request.resource.data;
      // the generation "<Unix seconds>_<nanoseconds>"; a timestamp's own seconds() is the second
      // within the minute, so both parts come from its duration since the Unix epoch
      let sinceEpoch = currentTimeline(timelineId).createdAt - timestamp.value(0);
      let prefix = 'timelines/' + timelineId + '/' + string(sinceEpoch.seconds()) + '_'
        + string(sinceEpoch.nanos()) + '/events/' + data.event_id
        + '/img_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}';
      return !('image' in data) || (
        data.image is map
        && data.image.keys().hasOnly(['ref', 'thumb_ref', 'width', 'height', 'mime', 'bytes', 'image_role'])
        && data.image.keys().hasAll(['ref', 'thumb_ref', 'width', 'height', 'mime', 'bytes', 'image_role'])
        && data.image.ref is string && data.image.ref.matches(prefix + '[.](webp|jpg)')
        && data.image.thumb_ref is string && data.image.thumb_ref.matches(prefix + '_thumb[.](webp|jpg)')
        && data.image.width is int && data.image.width > 0 && data.image.width <= 1600
        && data.image.height is int && data.image.height > 0 && data.image.height <= 1600
        && data.image.mime in ['image/webp', 'image/jpeg']
        && data.image.bytes is int && data.image.bytes > 0 && data.image.bytes <= 2097152
        && data.image.image_role == 'personal_photo');
    }

    function canUseTimeline(timeline) {
      return isMember()
        && (timeline.owner == request.auth.uid || request.auth.uid in timeline.members);
    }

    function validTimeline(data) {
      return data.keys().hasOnly(['owner', 'title', 'visibility', 'members', 'createdAt', 'updatedAt'])
        && data.title is string && data.title.size() > 0 && data.title.size() <= 120
        && data.visibility == 'private'
        && data.members is list && data.members.size() <= 20
        && !(data.owner in data.members)
        && data.updatedAt == request.time;
    }

    match /timelines/{timelineId} {
      allow read: if canUseTimeline(resource.data);
      allow create: if isEditor()
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.createdAt == request.time
        && validTimeline(request.resource.data);
      allow update: if isMember()
        && resource.data.owner == request.auth.uid
        && request.resource.data.owner == resource.data.owner
        && request.resource.data.createdAt == resource.data.createdAt
        && validTimeline(request.resource.data);
      allow delete: if isMember() && resource.data.owner == request.auth.uid;

      match /events/{eventId} {
        allow read, delete: if exists(timelinePath(timelineId))
          && canUseTimeline(currentTimeline(timelineId))
          && resource.data.timelineCreatedAt == currentTimeline(timelineId).createdAt;
        allow create: if exists(timelinePath(timelineId))
          && canUseTimeline(currentTimeline(timelineId))
          && validTimelineEvent(timelineId, eventId);
        allow update: if exists(timelinePath(timelineId))
          && canUseTimeline(currentTimeline(timelineId))
          && resource.data.timelineCreatedAt == currentTimeline(timelineId).createdAt
          && validTimelineEvent(timelineId, eventId);
      }
    }
  }
}
